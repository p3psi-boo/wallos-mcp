# Wallos installation root; append the installation subdirectory if needed.
WALLOS_BASE_URL="http://127.0.0.1:8080/"
WALLOS_API_KEY="TOKEN"
# Independent MCP token: replace with at least 32 random characters.
MCP_AUTH_TOKEN="TOKEN_REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
ALLOW_HTTP_UPSTREAM="true"
TIMEZONE="UTC"
# Exact browser Origins, comma-separated. Requests without Origin remain valid.
ALLOWED_ORIGINS="http://localhost:6274,http://localhost:6277"
