{
  "name": "wallos-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "smoke": "tsx scripts/smoke.ts",
    "contract": "tsx scripts/contract.ts",
    "schema:refresh": "tsx scripts/snapshot-openapi.ts && npm run schema:generate",
    "schema:generate": "tsx scripts/bundle-openapi.ts && openapi-typescript vendor/wallos/bundled.yaml -o src/wallos/generated.d.ts",
    "mock": "tsx scripts/mock-wallos.ts",
    "smoke:write": "tsx scripts/smoke-write.ts",
    "start": "node --env-file-if-exists=.env dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "decimal.js": "10.6.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "26.6.4",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "description": "Stateless, self-hosted MCP HTTP server for Wallos subscription management",
  "license": "WTFPL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p3psi-boo/wallos-mcp.git"
  },
  "homepage": "https://github.com/p3psi-boo/wallos-mcp#readme",
  "bugs": {
    "url": "https://github.com/p3psi-boo/wallos-mcp/issues"
  },
  "keywords": [
    "wallos",
    "mcp",
    "subscriptions",
    "streamable-http",
    "self-hosted",
    "stateless"
  ]
}
