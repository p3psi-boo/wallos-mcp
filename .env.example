# Wallos installation root, including its installation subdirectory if needed.
WALLOS_BASE_URL="https://HOST/wallos/"
WALLOS_API_KEY="TOKEN"
# Independent MCP token; generate with: openssl rand -hex 32
MCP_AUTH_TOKEN="TOKEN_REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
HOST="127.0.0.1"
PORT="8787"
TIMEZONE="UTC"
UPSTREAM_TIMEOUT_MS="10000"
ALLOW_HTTP_UPSTREAM="false"
# Exact browser Origins, comma-separated. Requests without Origin remain valid.
ALLOWED_ORIGINS=""
# Stateless destructive-operation confirmation; generate independently: openssl rand -hex 32
# Required for deletion previews and when configuration tools are enabled.
# All replicas must share this value. Rotating it invalidates outstanding confirmations.
MCP_CONFIRMATION_KEY="TOKEN_REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
# Exposes seven optional configuration/admin tools; Wallos still checks account privileges.
ENABLE_CONFIGURATION_TOOLS="false"
# Optional secrets referenced with use_configured, never accepted as raw tool arguments.
# Leave unset until needed. Omitted secret fields preserve existing settings.
# WALLOS_FIXER_API_KEY="TOKEN"
# WALLOS_SMTP_PASSWORD="TOKEN"
# WALLOS_OIDC_CLIENT_SECRET="TOKEN"
