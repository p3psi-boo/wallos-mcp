{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wallos-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {"TIMEZONE": "UTC", "UPSTREAM_TIMEOUT_MS": "10000", "ALLOW_HTTP_UPSTREAM": "false", "ALLOWED_ORIGINS": ""},
  "durable_objects": {"bindings": [{"name": "WALLOS_ACCOUNT", "class_name": "WallosAccount"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["WallosAccount"]}],
  "observability": {"enabled": false}
}
